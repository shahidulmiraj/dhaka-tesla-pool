# Used by docker compose. Copy to .env; never commit .env.
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla_local_only
POSTGRES_DB=tesla_pool
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-random-chars
JWT_EXPIRES_IN=24h
# Host port for the web app (change only if 3000 is taken; CORS follows it)
WEB_PORT=3000
